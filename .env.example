# Master feature flag. Keep 'false' until you've validated observe-mode output.
SUPERVEA_PREFLIGHT_ENABLED=false

# 'observe' logs decisions without acting on them. 'optimize' controls routing.
SUPERVEA_PREFLIGHT_MODE=observe

SUPERVEA_ENV=prod

# Supabase Postgres connection string
SUPERVEA_DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis connection string
SUPERVEA_REDIS_URL=redis://localhost:6379/0

# OpenRouter (primary adapter)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fail-open decision budget, in milliseconds
SUPERVEA_PREFLIGHT_TIMEOUT_MS=10

# Decision cache TTL, in seconds
SUPERVEA_PREFLIGHT_DECISION_CACHE_TTL=120
